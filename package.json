{
  "name": "bd2-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "pnpm test && pnpm build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "pnpm prepare:assets",
    "prebuild": "pnpm prepare:assets",
    "pretest": "pnpm prepare:assets",
    "format": "prettier --write src scripts tests docs README.md vite.config.ts package.json vercel.json tsconfig.json",
    "test:sql": "node scripts/audit-sql.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@mdx-js/react": "3.1.1",
    "codemirror": "6.0.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
